---
import CertificateTimeline from "@/components/organisms/CertificateTimeline.astro";
import Section from "@/components/atoms/Section.astro";
import { getMainResumeWithData } from "@/core/resume/resume/resume.service";
import { DEFAULT_LOCALE } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;

const locale = DEFAULT_LOCALE;
const resume = await getMainResumeWithData({ lang: locale });
if (!resume) throw new Error("Failed to fetch main resume");

const certificates = resume.certificates ?? [];
const title = "Certifications";
const description = `All ${certificates.length} certifications earned by Yuniel Acosta.`;
---

<Layout title={title} description={description}>
	<div class="mx-auto max-w-6xl px-4 pb-12 pt-28 sm:px-6 lg:px-8">
		<header class="mb-12">
			<a class="back-link" href="/">← Back to portfolio</a>
			<h1 class="mt-6 text-4xl font-bold text-foreground md:text-5xl">
				{title}
			</h1>
			<p class="mt-4 text-lg text-primary">{description}</p>
		</header>
		<Section title={title}>
			<CertificateTimeline certificates={certificates} locale={locale} />
		</Section>
	</div>
</Layout>

<style>
.back-link {
	color: var(--color-brand-accent);
	text-underline-offset: 0.25em;
}

.back-link:hover {
	text-decoration: underline;
}
</style>
