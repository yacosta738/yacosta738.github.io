{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Renovate configuration for yacosta738.github.io monorepo",
	"extends": [
		"config:best-practices"
	],
	"enabledManagers": [
		"npm",
		"github-actions",
		"dockerfile",
		"docker-compose"
	],
	"timezone": "Europe/Madrid",
	"schedule": [
		"* 0-23 * * 1"
	],
	"updateNotScheduled": true,
	"semanticCommits": "enabled",
	"commitMessagePrefix": "fix(deps):",
	"bumpVersion": "patch",
	"rangeStrategy": "bump",
	"assignees": [
		"yacosta738"
	],
	"reviewers": [
		"yacosta738"
	],
	"assignAutomerge": true,
	"assigneesFromCodeOwners": false,
	"reviewersFromCodeOwners": false,
	"labels": [
		"dependencies",
		"renovate"
	],
	"dependencyDashboard": true,
	"dependencyDashboardApproval": false,
	"dependencyDashboardAutoclose": true,
	"dependencyDashboardTitle": "🤖 Renovate Dependency Dashboard",
	"dependencyDashboardHeader": "This issue lists Renovate updates and detected dependencies. Read the [Dependency Dashboard docs](https://docs.renovatebot.com/key-concepts/dashboard/) to learn more.",
	"dependencyDashboardFooter": "---\n\n🔧 Configure Renovate in [renovate.json](https://github.com/yacosta738/yacosta738.github.io/blob/main/renovate.json)",
	"ignorePaths": [
		"**/node_modules/**",
		"**/bower_components/**",
		"**/vendor/**",
		"**/__tests__/**",
		"**/test/**",
		"**/tests/**",
		"**/__mocks__/**"
	],
	"minimumReleaseAge": "3 days",
	"internalChecksFilter": "strict",
	"prCreation": "immediate",
	"prConcurrentLimit": 4,
	"branchConcurrentLimit": 4,
	"prHourlyLimit": 2,
	"rebaseWhen": "auto",
	"separateMajorMinor": true,
	"separateMinorPatch": true,
	"separateMultipleMajor": true,
	"automerge": false,
	"automergeType": "pr",
	"platformAutomerge": false,
	"ignoreTests": false,
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": [
			"* 0-23 * * 1"
		],
		"automerge": true,
		"addLabels": [
			"lockfile",
			"automerge"
		]
	},
	"packageRules": [
		{
			"description": "Keep major updates manual; related packages can retain preset groups.",
			"matchUpdateTypes": [
				"major"
			],
			"automerge": false,
			"commitMessagePrefix": "feat(deps)!:",
			"addLabels": [
				"major-update"
			],
			"prPriority": 0
		},
		{
			"description": "Batch patch updates for npm/pnpm dependencies.",
			"matchManagers": [
				"npm"
			],
			"matchUpdateTypes": [
				"patch"
			],
			"groupName": "npm/pnpm dependencies (patch)",
			"groupSlug": "npm-patch",
			"groupSingleUpdates": true,
			"automerge": true,
			"addLabels": [
				"patch-update",
				"automerge"
			],
			"prPriority": 5
		},
		{
			"description": "Batch minor updates for npm/pnpm dependencies.",
			"matchManagers": [
				"npm"
			],
			"matchUpdateTypes": [
				"minor"
			],
			"groupName": "npm/pnpm dependencies (minor)",
			"groupSlug": "npm-minor",
			"groupSingleUpdates": true,
			"automerge": false,
			"addLabels": [
				"minor-update"
			],
			"prPriority": 3
		},
		{
			"description": "Batch patch updates for GitHub Actions.",
			"matchManagers": [
				"github-actions"
			],
			"matchUpdateTypes": [
				"patch"
			],
			"groupName": "GitHub Actions (patch)",
			"groupSlug": "github-actions-patch",
			"groupSingleUpdates": true,
			"automerge": true,
			"addLabels": [
				"patch-update",
				"github-actions",
				"automerge"
			],
			"prPriority": 5
		},
		{
			"description": "Batch minor updates for GitHub Actions.",
			"matchManagers": [
				"github-actions"
			],
			"matchUpdateTypes": [
				"minor"
			],
			"groupName": "GitHub Actions (minor)",
			"groupSlug": "github-actions-minor",
			"groupSingleUpdates": true,
			"automerge": false,
			"addLabels": [
				"minor-update",
				"github-actions"
			],
			"prPriority": 3
		},
		{
			"description": "Batch patch updates for Docker images.",
			"matchManagers": [
				"dockerfile",
				"docker-compose"
			],
			"matchUpdateTypes": [
				"patch"
			],
			"groupName": "Docker images (patch)",
			"groupSlug": "docker-patch",
			"groupSingleUpdates": true,
			"automerge": true,
			"addLabels": [
				"patch-update",
				"docker",
				"automerge"
			],
			"prPriority": 5
		},
		{
			"description": "Batch minor updates for Docker images.",
			"matchManagers": [
				"dockerfile",
				"docker-compose"
			],
			"matchUpdateTypes": [
				"minor"
			],
			"groupName": "Docker images (minor)",
			"groupSlug": "docker-minor",
			"groupSingleUpdates": true,
			"automerge": false,
			"addLabels": [
				"minor-update",
				"docker"
			],
			"prPriority": 3
		},
		{
			"description": "Keep pnpm toolchain updates separate from application dependencies.",
			"matchManagers": [
				"npm"
			],
			"matchPackageNames": [
				"pnpm"
			],
			"matchUpdateTypes": [
				"patch",
				"minor"
			],
			"groupName": null,
			"groupSlug": null,
			"addLabels": [
				"pnpm"
			]
		},
		{
			"description": "Batch GitHub Actions pin and digest changes for manual review.",
			"matchManagers": [
				"github-actions"
			],
			"matchUpdateTypes": [
				"pin",
				"pinDigest",
				"digest"
			],
			"groupName": "GitHub Actions pins and digests",
			"groupSlug": "github-actions-pins-digests",
			"groupSingleUpdates": true,
			"automerge": false,
			"addLabels": [
				"github-actions"
			]
		},
		{
			"description": "Batch Docker pin and digest changes for manual review.",
			"matchManagers": [
				"dockerfile",
				"docker-compose"
			],
			"matchUpdateTypes": [
				"pin",
				"pinDigest",
				"digest"
			],
			"groupName": "Docker pins and digests",
			"groupSlug": "docker-pins-digests",
			"groupSingleUpdates": true,
			"automerge": false,
			"addLabels": [
				"docker"
			]
		},
		{
			"description": "Pre-1.0 patch updates may break compatibility; review them separately.",
			"matchUpdateTypes": [
				"patch"
			],
			"matchCurrentVersion": "/^0\\./",
			"groupName": "Pre-1.0 patches",
			"groupSlug": "pre-1-patches",
			"groupSingleUpdates": true,
			"automerge": false,
			"labels": [
				"dependencies",
				"renovate",
				"patch-update",
				"pre-1.0"
			],
			"addLabels": [
				"pre-1.0"
			]
		},
		{
			"description": "Keep manual-review branches from rebasing solely because main advanced.",
			"matchUpdateTypes": [
				"major",
				"minor",
				"pin",
				"pinDigest",
				"digest"
			],
			"rebaseWhen": "conflicted"
		}
	],
	"vulnerabilityAlerts": {
		"enabled": true,
		"automerge": false,
		"groupName": null,
		"groupSlug": null,
		"minimumReleaseAge": null,
		"schedule": [],
		"prPriority": 10,
		"labels": [
			"dependencies",
			"renovate",
			"security",
			"vulnerability"
		],
		"addLabels": []
	}
}
